# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (Neon)
# Copy your pooled connection string from https://console.neon.tech/
# and extract these values from it, or fill them in manually
# ─────────────────────────────────────────────────────────────────────────────
DB_TYPE="postgresdb"
DB_POSTGRESDB_HOST="ep-rapid-bar-atc6hiq1-pooler.c-9.us-east-1.aws.neon.tech"
DB_POSTGRESDB_PORT="5432"
DB_POSTGRESDB_DATABASE="neondb"
DB_POSTGRESDB_USER="neondb_owner"
DB_POSTGRESDB_PASSWORD="npg_a40eOyXQofHi"
DB_POSTGRESDB_SSL_ENABLED="true"
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED="true"
PGSSLMODE="require"
PGCHANNELBINDING="require"

# ─────────────────────────────────────────────────────────────────────────────
# n8n INSTANCE CONFIG
# ─────────────────────────────────────────────────────────────────────────────
N8N_HOST="n8n-home-enk1.onrender.com"
N8N_PROTOCOL="https"
N8N_PORT="5678"
WEBHOOK_URL="https://n8n-home-enk1.onrender.com"
GENERIC_TIMEZONE="Asia/Baghdad"

# ─────────────────────────────────────────────────────────────────────────────
# NODE & RUNTIME
# ─────────────────────────────────────────────────────────────────────────────
NPM_CONFIG_LOGLEVEL="warn"
NODE_FUNCTION_ALLOW_EXTERNAL="telegram-bot-api"
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS="true"

# ─────────────────────────────────────────────────────────────────────────────
# TELEGRAM (optional)
