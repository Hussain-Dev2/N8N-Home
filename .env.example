# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (Neon PostgreSQL)
# Copy your pooled connection parameters from https://console.neon.tech/
# ─────────────────────────────────────────────────────────────────────────────
DB_TYPE="postgresdb"
DB_POSTGRESDB_HOST="ep-xxxx-xxxx-pooler.c-9.us-east-1.aws.neon.tech"
DB_POSTGRESDB_PORT="5432"
DB_POSTGRESDB_DATABASE="neondb"
DB_POSTGRESDB_USER="neondb_owner"
DB_POSTGRESDB_PASSWORD="your-neon-password"
DB_POSTGRESDB_SSL_ENABLED="true"
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED="true"
PGSSLMODE="require"
PGCHANNELBINDING="require"

# ─────────────────────────────────────────────────────────────────────────────
# n8n INSTANCE CONFIG
# ─────────────────────────────────────────────────────────────────────────────
# Encryption key used to secure credentials stored in the database.
# Generate one with: openssl rand -hex 24
N8N_ENCRYPTION_KEY="replace-with-a-secure-random-encryption-key"

# Public host and protocol
N8N_HOST="n8n-render-tonnel.onrender.com"
N8N_PROTOCOL="https"
N8N_PORT="5678"
WEBHOOK_URL="https://n8n-render-tonnel.onrender.com"
N8N_EDITOR_BASE_URL="https://n8n-render-tonnel.onrender.com"
N8N_PUSH_BACKEND="websocket"
GENERIC_TIMEZONE="Asia/Baghdad"

# ─────────────────────────────────────────────────────────────────────────────
# NODE & RUNTIME
# ─────────────────────────────────────────────────────────────────────────────
NPM_CONFIG_LOGLEVEL="warn"
NODE_FUNCTION_ALLOW_EXTERNAL="telegram-bot-api"
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS="true"

# ─────────────────────────────────────────────────────────────────────────────
# TELEGRAM (optional)
# ─────────────────────────────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# Reference connection string format:
# postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require
